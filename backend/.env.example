# Database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vahanone_db

# JWT Security
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Role Defaults
DEFAULT_USER_ROLE=member
ADMIN_ROLE_NAME=admin

# Background Scheduler
ENABLE_REMINDER_SCHEDULER=true
REMINDER_SCHEDULER_INTERVAL_MINUTES=60

# Optional Supabase Integration (if verifying Supabase tokens)
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret
